---
import EmptyState from '../molecules/EmptyState.astro';
import type { BlogPostEntry } from '../../utils/blog';
import { formatPostDate, getReadingTimeMinutes, toTaxonomySlug } from '../../utils/blog';

interface Props {
	posts: BlogPostEntry[];
	emptyTitle?: string;
	emptyDescription?: string;
}

const {
	posts,
	emptyTitle = 'No blog posts yet.',
	emptyDescription = 'Published blog entries will appear here.',
} = Astro.props;
---

{
	posts.length > 0 ? (
		<ul class="m-0 list-none p-0">
			{posts.map((post) => (
				<li class="border-b-2 border-dashed border-site-border first:border-t-2">
					<div class="m-0 px-3 py-6 transition-[background-color,transform] duration-150 hover:rotate-[0.15deg] hover:bg-site-surface-soft">
						<a
							class="group flex items-start justify-between gap-4 rounded-md pb-[0.35rem] no-underline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-[rgba(var(--accent-rgb),0.45)] max-[720px]:block"
							href={`/blog/${post.id}/`}
						>
							<div class="min-w-0">
								<h4 class="m-0 font-site-sans text-2xl leading-[1.08] font-normal text-site-heading [text-wrap:balance] group-hover:text-site-accent group-focus-visible:text-site-accent max-[720px]:text-[1.25rem] max-[720px]:leading-[1.15]">
									{post.data.title}
								</h4>
								<p class="mt-[0.45rem] mb-0 leading-[1.55] text-site-muted [text-wrap:pretty] max-[720px]:text-[0.92rem] max-[720px]:leading-[1.6]">
									{post.data.description}
								</p>
							</div>
							<span class="inline-flex flex-none items-center gap-[0.55rem] max-[720px]:mt-1">
								<time
									class="m-0 whitespace-nowrap font-mono text-[0.78rem] tracking-[0.02em] text-site-muted max-[720px]:text-[0.72rem]"
									datetime={post.data.pubDate.toISOString()}
								>
									{post.data.category} / {formatPostDate(post.data.pubDate)}
								</time>
								<span class="size-[0.45rem] rotate-45 border-t-2 border-r-2 border-[rgba(var(--gray),0.78)]" aria-hidden="true" />
							</span>
						</a>
						<ul
							class="mt-[0.6rem] flex list-none flex-wrap gap-[0.35rem] p-0 font-mono text-[0.76rem] leading-[1.45] text-site-muted"
							aria-label={`${post.data.title} metadata`}
						>
							<li>約{getReadingTimeMinutes(post.body)}分</li>
							{post.data.tags.map((tag) => (
								<li>
									<a
										class="inline-flex min-h-6 -rotate-1 items-center rounded-[5px_9px_6px_8px] border-2 border-dashed border-site-border bg-site-surface px-2 text-site-muted no-underline even:rotate-1 hover:rotate-0 hover:border-site-accent hover:text-site-accent focus-visible:border-site-accent focus-visible:text-site-accent"
										href={`/tags/${toTaxonomySlug(tag)}/`}
									>
										{tag}
									</a>
								</li>
							))}
						</ul>
					</div>
				</li>
			))}
		</ul>
	) : (
		<EmptyState title={emptyTitle} description={emptyDescription} ariaLabel="No blog posts" />
	)
}
